@model List<FarmhouseBakery.Models.JobPosting>

@{
    ViewData["Title"] = "Manage Careers";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Manage Careers - Farmhouse Bakery</title>

    <style>
        * { box-sizing: border-box; }

        body { margin: 0; font-family: Arial, sans-serif; background: #f5f5f5; color: #333; }

        .admin_header { background: #000; color: white; padding: 20px 40px; display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }

        .admin_header h1 { margin: 0; font-size: 24px; }

        .back_home { color: white; text-decoration: none; }

        .back_home:hover { color: #ffbe33; }

        .page_container { max-width: 1000px; margin: 40px auto; padding: 0 20px; }

        .page_top { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 20px; }

        .page_top h2 { margin: 0; }

        .view_btn { color: #d89500; font-weight: bold; text-decoration: none; }

        .msg { padding: 12px 16px; border-radius: 6px; margin-bottom: 20px; background: #e8f6ea; color: #1e6b2b; border: 1px solid #b7e0bd; }

        .error { color: #c62828; margin-bottom: 12px; }

        .form_card { background: white; padding: 28px; border-radius: 10px; box-shadow: 0 4px 15px rgba(0,0,0,0.08); margin-bottom: 30px; }

        .form_card h3 { margin-top: 0; }

        .form_grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 16px; }

        .form_group { display: flex; flex-direction: column; }

        .form_group.full { grid-column: 1 / -1; }

        .form_group label { font-weight: bold; margin-bottom: 6px; }

        .form_group input, .form_group select, .form_group textarea { padding: 11px; border: 1px solid #ccc; border-radius: 6px; font-size: 15px; font-family: inherit; }

        .form_group textarea { min-height: 160px; resize: vertical; }

        .hint { color: #888; font-size: 13px; margin-top: 4px; }

        .form_actions { display: flex; gap: 10px; margin-top: 20px; }

        .save_btn { background: #ffbe33; color: #222; border: none; padding: 12px 26px; border-radius: 25px; font-weight: bold; cursor: pointer; }

        .save_btn:hover { background: #e69c00; }

        .cancel_btn { background: #eee; color: #333; border: none; padding: 12px 22px; border-radius: 25px; cursor: pointer; display: none; }

        .job_row { background: white; border-radius: 10px; padding: 20px 24px; margin-bottom: 14px; box-shadow: 0 4px 15px rgba(0,0,0,0.06); display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; }

        .job_row h4 { margin: 0 0 6px; }

        .job_info { color: #777; font-size: 14px; }

        .badge { display: inline-block; padding: 3px 10px; border-radius: 12px; font-size: 12px; font-weight: bold; margin-left: 8px; vertical-align: middle; }

        .badge_live { background: #e8f6ea; color: #1e6b2b; }

        .badge_hidden { background: #e4e4e4; color: #555; }

        .actions { display: flex; gap: 8px; flex-wrap: wrap; }

        .actions form { margin: 0; }

        .btn { border: none; padding: 8px 14px; border-radius: 5px; cursor: pointer; font-weight: bold; }

        .edit_btn { background: #3498db; color: white; }

        .toggle_btn { background: #eee; color: #333; }

        .delete_btn { background: #dc3545; color: white; }

        .empty_message { text-align: center; padding: 40px; color: #777; background: white; border-radius: 10px; }

        @@media (max-width: 700px) {
            .admin_header { padding: 16px; }
            .form_grid { grid-template-columns: 1fr; }
        }
    </style>
</head>

<body>

    <header class="admin_header">
        <h1>Farmhouse Bakery</h1>
        <a href="/Home/AdminIndex" class="back_home">← Back to Main</a>
    </header>

    <main class="page_container">

        <div class="page_top">
            <h2>Manage Careers</h2>
            <div style="display: flex; gap: 20px; flex-wrap: wrap;">
                <a href="/Careers/Applications" class="view_btn">View Applications</a>
                <a href="/Careers" class="view_btn" target="_blank">View Careers page ↗</a>
            </div>
        </div>

        @if (TempData["Message"] is string message)
        {
            <div class="msg">@message</div>
        }

        <!-- ADD / EDIT FORM -->
        <div class="form_card">
            <h3 id="formTitle">Add Job Posting</h3>

            <form asp-controller="Careers" asp-action="Save" method="post" id="jobForm">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="All" class="error"></div>

                <input type="hidden" id="jobId" name="Id" value="0" />

                <div class="form_grid">

                    <div class="form_group">
                        <label for="jobTitle">Job Title</label>
                        <input type="text" id="jobTitle" name="Title" maxlength="100"
                               placeholder="e.g. Baker" required />
                    </div>

                    <div class="form_group">
                        <label for="jobType">Job Type</label>
                        <select id="jobType" name="JobType" required>
                            <option value="">Select type</option>
                            <option value="Full-time">Full-time</option>
                            <option value="Part-time">Part-time</option>
                            <option value="Seasonal">Seasonal</option>
                            <option value="Casual">Casual</option>
                        </select>
                    </div>

                    <div class="form_group">
                        <label for="jobPay">Pay (optional)</label>
                        <input type="text" id="jobPay" name="Pay" maxlength="100"
                               placeholder="e.g. $17/hour" />
                    </div>

                    <div class="form_group full">
                        <label for="jobDescription">Description</label>
                        <textarea id="jobDescription" name="Description" maxlength="4000" required
                                  placeholder="Duties, hours, requirements..."></textarea>
                        <span class="hint">Line breaks are kept on the Careers page.</span>
                    </div>

                </div>

                <div class="form_actions">
                    <button type="submit" class="save_btn" id="saveBtn">Add Posting</button>
                    <button type="button" class="cancel_btn" id="cancelBtn" onclick="resetForm()">Cancel</button>
                </div>

            </form>
        </div>

        <!-- POSTINGS -->
        <h3>All Postings (@Model.Count)</h3>

        @if (Model.Count == 0)
        {
            <div class="empty_message">No job postings yet. Add one above.</div>
        }

        @foreach (var job in Model)
        {
            <div class="job_row">

                <div>
                    <h4>
                        @job.Title
                        @if (job.IsActive)
                        {
                            <span class="badge badge_live">Showing</span>
                        }
                        else
                        {
                            <span class="badge badge_hidden">Hidden</span>
                        }
                    </h4>
                    <div class="job_info">
                        @job.JobType
                        @if (!string.IsNullOrWhiteSpace(job.Pay))
                        {
                            <text> · @job.Pay</text>
                        }
                        · Posted @job.PostedDate.ToLocalTime().ToString("MMM d, yyyy")
                    </div>
                </div>

                <div class="actions">
                    <a class="btn toggle_btn" style="text-decoration: none;"
                       asp-controller="Careers" asp-action="Details" asp-route-id="@job.Id"
                       target="_blank">
                        View
                    </a>

                    <a class="btn toggle_btn" style="text-decoration: none;"
                       asp-controller="Careers" asp-action="Applications" asp-route-jobId="@job.Id">
                        Applications
                    </a>

                    <button type="button" class="btn edit_btn"
                            data-id="@job.Id"
                            data-title="@job.Title"
                            data-type="@job.JobType"
                            data-pay="@job.Pay"
                            data-description="@job.Description"
                            onclick="editJob(this)">
                        Edit
                    </button>

                    <form asp-controller="Careers" asp-action="ToggleActive" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@job.Id" />
                        <button type="submit" class="btn toggle_btn">
                            @(job.IsActive ? "Hide" : "Show")
                        </button>
                    </form>

                    <form asp-controller="Careers" asp-action="Delete" method="post"
                          onsubmit="return confirm('Delete this job posting?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@job.Id" />
                        <button type="submit" class="btn delete_btn">Delete</button>
                    </form>
                </div>

            </div>
        }

    </main>

    <script>
        // Fill the form with a posting so it can be edited.
        function editJob(button) {
            document.getElementById("jobId").value = button.dataset.id;
            document.getElementById("jobTitle").value = button.dataset.title;
            document.getElementById("jobType").value = button.dataset.type;
            document.getElementById("jobPay").value = button.dataset.pay || "";
            document.getElementById("jobDescription").value = button.dataset.description;

            document.getElementById("formTitle").textContent = "Edit Job Posting";
            document.getElementById("saveBtn").textContent = "Save Changes";
            document.getElementById("cancelBtn").style.display = "inline-block";

            document.getElementById("jobForm").scrollIntoView({ behavior: "smooth" });
        }

        function resetForm() {
            document.getElementById("jobForm").reset();
            document.getElementById("jobId").value = "0";

            document.getElementById("formTitle").textContent = "Add Job Posting";
            document.getElementById("saveBtn").textContent = "Add Posting";
            document.getElementById("cancelBtn").style.display = "none";
        }
    </script>

</body>

</html>
