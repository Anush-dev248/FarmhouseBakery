@model List<FarmhouseBakery.Models.UserListItemViewModel>

@{ ViewData["Title"] = "Users"; }

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Users - Farmhouse Bakery</title>

    <style>
        * { box-sizing: border-box; }

        body { margin: 0; font-family: Arial, sans-serif; background: #f5f5f5; color: #333; }

        .admin_header { background: #000; color: white; padding: 20px 40px; display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }

        .admin_header h1 { margin: 0; font-size: 24px; }

        .back_home { color: white; text-decoration: none; }

        .back_home:hover { color: #ffbe33; }

        .page_container { max-width: 1000px; margin: 40px auto; padding: 0 20px; }

        .page_top { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 20px; }

        .page_top h2 { margin: 0; }

        .add_btn { background: #ffbe33; color: #222; padding: 10px 20px; border-radius: 25px; text-decoration: none; font-weight: bold; }

        .add_btn:hover { background: #e69c00; color: #222; }

        .summary { color: #666; margin-bottom: 20px; }

        .msg { padding: 12px 16px; border-radius: 6px; margin-bottom: 20px; }

        .msg_ok { background: #e8f6ea; color: #1e6b2b; border: 1px solid #b7e0bd; }

        .msg_error { background: #fdecec; color: #a12a2a; border: 1px solid #f3c0c0; }

        .user_table { width: 100%; border-collapse: collapse; background: white; border-radius: 10px; overflow: hidden; box-shadow: 0 4px 15px rgba(0,0,0,0.08); }

        .user_table th, .user_table td { padding: 14px 16px; text-align: left; border-bottom: 1px solid #eee; vertical-align: middle; }

        .user_table th { background: #222; color: white; font-weight: 600; }

        .user_table tr:last-child td { border-bottom: none; }

        .badge { display: inline-block; padding: 4px 10px; border-radius: 12px; font-size: 13px; font-weight: bold; }

        .badge_admin { background: #ffbe33; color: #222; }

        .badge_user { background: #e4e4e4; color: #444; }

        .badge_locked { background: #fdecec; color: #a12a2a; margin-left: 6px; }

        .you { color: #888; font-size: 13px; margin-left: 6px; }

        .role_btn { border: none; padding: 8px 16px; border-radius: 20px; cursor: pointer; font-weight: bold; }

        .make_admin { background: #ffbe33; color: #222; }

        .make_admin:hover { background: #e69c00; }

        .remove_admin { background: #eee; color: #a12a2a; }

        .remove_admin:hover { background: #fdecec; }

        .muted { color: #999; font-size: 13px; }

        @@media (max-width: 640px) {
            .admin_header { padding: 16px; }

            .user_table thead { display: none; }

            .user_table, .user_table tbody, .user_table tr, .user_table td { display: block; width: 100%; }

            .user_table tr { border-bottom: 1px solid #eee; padding: 8px 0; }

            .user_table td { border: none; padding: 6px 16px; }
        }
    </style>
</head>

<body>

    <header class="admin_header">
        <h1>Farmhouse Bakery</h1>
        <a href="/Home/AdminIndex" class="back_home">← Back to Main</a>
    </header>

    <main class="page_container">

        <div class="page_top">
            <h2>Users</h2>
            <a href="/Account/Register" class="add_btn">+ Add User</a>
        </div>

        <p class="summary">
            @Model.Count account(s) · @Model.Count(u => u.IsAdmin) admin(s)
        </p>

        @if (TempData["Message"] is string message)
        {
            <div class="msg msg_ok">@message</div>
        }

        @if (TempData["Error"] is string error)
        {
            <div class="msg msg_error">@error</div>
        }

        <table class="user_table">
            <thead>
                <tr>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td>
                            @user.Email
                            @if (user.IsCurrentUser)
                            {
                                <span class="you">(you)</span>
                            }
                        </td>

                        <td>
                            @if (user.IsAdmin)
                            {
                                <span class="badge badge_admin">Admin</span>
                            }
                            else
                            {
                                <span class="badge badge_user">User</span>
                            }

                            @if (user.IsLockedOut)
                            {
                                <span class="badge badge_locked">Locked</span>
                            }
                        </td>

                        <td>
                            @if (user.IsCurrentUser)
                            {
                                <span class="muted">—</span>
                            }
                            else
                            {
                                <form asp-controller="Users"
                                      asp-action="SetAdmin"
                                      method="post"
                                      onsubmit="return confirm('@(user.IsAdmin ? "Remove admin rights from this user?" : "Make this user an admin?")');">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden" name="id" value="@user.Id" />
                                    <input type="hidden" name="makeAdmin" value="@(user.IsAdmin ? "false" : "true")" />

                                    @if (user.IsAdmin)
                                    {
                                        <button type="submit" class="role_btn remove_admin">Remove Admin</button>
                                    }
                                    else
                                    {
                                        <button type="submit" class="role_btn make_admin">Make Admin</button>
                                    }
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>

    </main>

</body>

</html>
