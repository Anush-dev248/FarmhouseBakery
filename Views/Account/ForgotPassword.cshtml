@{ ViewData["Title"] = "Forgot Password"; Layout = null; }

<!DOCTYPE html> <html lang="en">

<head>

<meta charset="utf-8" />

<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<title>Forgot Password - Farmhouse Bakery</title>

<link rel="stylesheet" href="~/css/bakeryscript.css" />
<link rel="stylesheet" href="~/css/style.css" />
<link rel="stylesheet" href="~/css/responsive.css" />

<style>

* { box-sizing: border-box; margin: 0; padding: 0; }

body { font-family: Arial, sans-serif; background: #000; min-height: 100vh; }

/* HEADER */

.login_header { height: 80px; background: #000;

display: flex; align-items: center;

padding: 0 50px; }

.brand { display: flex; align-items: center;

text-decoration: none;

color: #ffffff;

font-size: 22px; font-weight: 600; }

.brand img { width: 50px; height: 50px;

object-fit: contain;

margin-right: 12px; }

/* FORGOT PASSWORD AREA */

.forgot_section {

min-height: calc(100vh - 80px);

display: flex;

justify-content: center; align-items: center;

padding: 40px 20px;

background: #f5f5f5; }

.forgot_box {

width: 100%; max-width: 430px;

background: #ffffff;

padding: 40px;

border-radius: 12px;

box-shadow: 0 8px 30px rgba(0, 0, 0, 0.18); }

/* LOGO */

.forgot_logo {

text-align: center;

margin-bottom: 10px; }

.forgot_logo img {

width: 75px; height: 75px;

object-fit: contain; }

/* TITLE */

.forgot_box h2 {

text-align: center;

color: #222;

font-size: 30px;

margin-top: 10px; margin-bottom: 8px; }

.forgot_subtitle {

text-align: center;

color: #777;

font-size: 14px;

line-height: 1.6;

margin-bottom: 30px; }

/* INPUT */

.input_group {

position: relative;

width: 100%;

margin-bottom: 20px; }

.field_icon {

position: absolute;

left: 16px; top: 50%;

transform: translateY(-50%);

width: 18px; height: 18px;

color: #888;

z-index: 2; }

.field_icon svg {

width: 100%; height: 100%;

fill: none;

stroke: currentColor;

stroke-width: 2;

stroke-linecap: round; stroke-linejoin: round; }

.input_group input {

display: block;

width: 100%;

height: 52px;

border: 1px solid #d5d5d5;

border-radius: 6px;

background: #ffffff;

padding: 0 15px 0 45px;

font-size: 15px;

color: #333;

outline: none; }

.input_group input:focus {

border-color: #ffbe33;

box-shadow: 0 0 0 2px rgba(255, 190, 51, 0.15); }

.input_group input::placeholder {

color: #999; }

/* BUTTON */

.reset_btn {

display: block;

width: 100%;

height: 52px;

border: none;

border-radius: 6px;

background: #ffbe33;

color: #ffffff;

font-size: 17px;

font-weight: 600;

cursor: pointer;

transition: 0.2s; }

.reset_btn:hover {

background: #e5a500; }

/* MESSAGE */

.message {

display: none;

margin-top: 20px;

padding: 12px 15px;

border-radius: 6px;

font-size: 14px;

line-height: 1.5;

text-align: center; }

.message.success {

display: block;

background: #e8f5e9;

color: #2e7d32;

border: 1px solid #c8e6c9; }

.message.error {

display: block;

background: #ffebee;

color: #c62828;

border: 1px solid #ffcdd2; }

/* BACK LINKS */

.back_links {

text-align: center;

margin-top: 25px; }

.back_links a {

color: #777;

text-decoration: none;

font-size: 14px; }

.back_links a:hover {

color: #d89500; }

.separator {

color: #ccc;

margin: 0 8px; }

/* MOBILE */

@@media (max-width: 576px) {

.login_header {

padding: 0 20px; }

.brand {

font-size: 18px; }

.forgot_box {

padding: 30px 22px; }

.forgot_box h2 {

font-size: 26px; }

}

</style>

</head>

<body>

<!-- HEADER -->

<header class="login_header">

<a asp-controller="Home" asp-action="Index" class="brand">

<img src="~/images/LogoBLKbg.png" alt="Farmhouse Bakery" />

<span> Farmhouse Bakery </span>

</a>

</header>

<!-- FORGOT PASSWORD -->

<section class="forgot_section">

<div class="forgot_box">

<!-- LOGO -->

<div class="forgot_logo">

<img src="~/images/LogoBLKbg.png" alt="Farmhouse Bakery" />

</div>

<!-- TITLE -->

<h2> Forgot Password? </h2>

<p class="forgot_subtitle">

Enter the email address associated with your Farmhouse Bakery account and we will send you a password reset link.

</p>

<!-- FORM -->


<form asp-controller="Account"
      asp-action="ForgotPassword"
      method="post">
    @Html.AntiForgeryToken()

<!-- EMAIL -->

<div class="input_group">

<span class="field_icon">

<svg viewBox="0 0 24 24">

<rect x="3" y="5" width="18" height="14" rx="2"> </rect>

<path d="M3 7l9 6 9-6"> </path>

</svg>

</span>

<input type="email" id="email" name="email" placeholder="Email Address" autocomplete="email" required />

</div>

<!-- BUTTON -->

<button type="submit" class="reset_btn" id="resetButton">

Send Reset Link

</button>

</form>
<div style="color:red; text-align:center; margin-top:15px;">
    @Html.ValidationSummary(false)
</div>
<!-- MESSAGE -->

<div id="message" class="message"> </div>

<!-- LINKS -->

<div class="back_links">

<a asp-controller="Account" asp-action="Login">

← Back to Login

</a>

<span class="separator"> | </span>

<a asp-controller="Home" asp-action="Index">

Home

</a>

</div>

</div>

</section>

<!-- JAVASCRIPT -->

</body>

</html>