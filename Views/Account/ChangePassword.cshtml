@model FarmhouseBakery.Models.ChangePasswordViewModel

@{
    ViewData["Title"] = "Change Password";
    Layout = null;

    string backUrl = User.IsInRole("Admin") ? "/Home/AdminIndex" : "/Home/Dashboard";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Change Password - Farmhouse Bakery</title>

    <style>
        * { box-sizing: border-box; }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f5f5f5;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }

        .reset-box {
            width: 100%;
            max-width: 430px;
            background: white;
            padding: 35px;
            border-radius: 12px;
            box-shadow: 0 8px 30px rgba(0,0,0,0.15);
        }

        h2 { text-align: center; color: #222; }

        p { text-align: center; color: #777; line-height: 1.5; }

        label {
            display: block;
            margin-top: 18px;
            margin-bottom: 7px;
            color: #333;
        }

        input {
            width: 100%;
            padding: 13px;
            border: 1px solid #ccc;
            border-radius: 6px;
            font-size: 15px;
        }

        button {
            width: 100%;
            margin-top: 25px;
            padding: 14px;
            border: none;
            border-radius: 6px;
            background: #ffbe33;
            color: white;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
        }

        .error { color: #c62828; }

        .success {
            background: #e8f6ea;
            color: #1e6b2b;
            border: 1px solid #b7e0bd;
            padding: 12px;
            border-radius: 6px;
            text-align: center;
        }

        a { color: #d89500; }
    </style>
</head>
<body>
    <div class="reset-box">
        <h2>Change Password</h2>
        <p>Enter your current password, then choose a new one.</p>

        @if (TempData["Message"] is string message)
        {
            <div class="success">@message</div>
        }

        <form asp-controller="Account"
              asp-action="ChangePassword"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="All" class="error"></div>

            <label asp-for="CurrentPassword">Current Password</label>
            <input asp-for="CurrentPassword" type="password"
                autocomplete="current-password" required />
            <span asp-validation-for="CurrentPassword" class="error"></span>

            <label asp-for="NewPassword">New Password</label>
            <input asp-for="NewPassword" type="password"
                autocomplete="new-password" required />
            <span asp-validation-for="NewPassword" class="error"></span>

            <label asp-for="ConfirmNewPassword">Confirm New Password</label>
            <input asp-for="ConfirmNewPassword" type="password"
                autocomplete="new-password" required />
            <span asp-validation-for="ConfirmNewPassword" class="error"></span>

            <button type="submit">Change Password</button>
        </form>

        <p><a href="@backUrl">← Back to Dashboard</a></p>
    </div>
    <script src="~/js/password-toggle.js" asp-append-version="true"></script>
</body>
</html>
