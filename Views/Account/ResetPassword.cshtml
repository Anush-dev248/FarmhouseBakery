
@model FarmhouseBakery.Models.ResetPasswordViewModel

@{
    ViewData["Title"] = "Reset Password";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reset Password - Farmhouse Bakery</title>

    <link rel="stylesheet" href="~/css/bakeryscript.css" />
    <link rel="stylesheet" href="~/css/style.css" />
    <link rel="stylesheet" href="~/css/responsive.css" />

    <style>
        * { box-sizing: border-box; }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f5f5f5;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }

        .reset-box {
            width: 100%;
            max-width: 430px;
            background: white;
            padding: 35px;
            border-radius: 12px;
            box-shadow: 0 8px 30px rgba(0,0,0,0.15);
        }

        h2 { text-align: center; color: #222; }

        p { text-align: center; color: #777; line-height: 1.5; }

        label {
            display: block;
            margin-top: 18px;
            margin-bottom: 7px;
            color: #333;
        }

        input {
            width: 100%;
            padding: 13px;
            border: 1px solid #ccc;
            border-radius: 6px;
            font-size: 15px;
        }

        button {
            width: 100%;
            margin-top: 25px;
            padding: 14px;
            border: none;
            border-radius: 6px;
            background: #ffbe33;
            color: white;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
        }

        .error { color: #c62828; }
    </style>
</head>
<body>
    <div class="reset-box">
        <h2>Reset Your Password</h2>
        <p>Enter your new password below.</p>

        <form asp-controller="Account"
              asp-action="ResetPassword"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="Email" />
            <input type="hidden" asp-for="Token" />

            <div asp-validation-summary="All" class="error"></div>

            <label asp-for="Password">New Password</label>
            <input asp-for="Password" type="password"
                autocomplete="new-password" required />
            <span asp-validation-for="Password" class="error"></span>

            <label asp-for="ConfirmPassword">Confirm New Password</label>
            <input asp-for="ConfirmPassword" type="password"
                autocomplete="new-password" required />
            <span asp-validation-for="ConfirmPassword" class="error"></span>

            <button type="submit">Update Password</button>
        </form>

        <p><a asp-controller="Account" asp-action="Login">Back to Login</a></p>
    </div>
    <script src="~/js/password-toggle.js" asp-append-version="true"></script>
</body>
</html>