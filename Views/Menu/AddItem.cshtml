@{
    ViewData["Title"] = "Add Menu Item";
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Add Menu Item - Farmhouse Bakery</title>

    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f5f5f5;
        }

        .admin_header {
            background: #000;
            color: white;
            padding: 20px 40px;
        }

        .admin_header h2 {
            margin: 0;
        }

        .page_container {
            max-width: 900px;
            margin: 40px auto;
            padding: 0 20px;
        }

        .form_box {
            background: white;
            padding: 35px;
            border-radius: 12px;
            box-shadow: 0 5px 25px rgba(0, 0, 0, 0.12);
        }

        .form_box h1 {
            margin-top: 0;
            margin-bottom: 30px;
            color: #222;
        }

        .form_group {
            margin-bottom: 20px;
        }

        .form_group label {
            display: block;
            margin-bottom: 8px;
            font-weight: 600;
            color: #333;
        }

        .form_group input,
        .form_group textarea,
        .form_group select {
            width: 100%;
            padding: 13px;
            border: 1px solid #ccc;
            border-radius: 6px;
            font-size: 15px;
            outline: none;
        }

        .form_group input:focus,
        .form_group textarea:focus,
        .form_group select:focus {
            border-color: #ffbe33;
        }

        .form_group textarea {
            min-height: 120px;
            resize: vertical;
        }

        .image_preview {
            margin-top: 15px;
            display: none;
        }

        .image_preview img {
            width: 150px;
            height: 150px;
            object-fit: contain;
            border: 1px solid #ddd;
            border-radius: 8px;
        }

        .button_area {
            display: flex;
            gap: 15px;
            margin-top: 30px;
        }

        .btn {
            padding: 13px 25px;
            border: none;
            border-radius: 6px;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
        }

        .btn_add {
            background: #ffbe33;
            color: white;
        }

        .btn_add:hover {
            background: #e5a500;
        }

        .btn_cancel {
            background: #ddd;
            color: #333;
        }

        .btn_cancel:hover {
            background: #ccc;
        }

        @@media (max-width: 600px) {

            .admin_header {
                padding: 20px;
            }

            .form_box {
                padding: 25px 20px;
            }

            .button_area {
                flex-direction: column;
            }

        }

    </style>

</head>

<body>

    <header class="admin_header">

        <h2>
            Farmhouse Bakery - Admin
        </h2>

    </header>


    <main class="page_container">

        <div class="form_box">

            <h1>
                Add Menu Item
            </h1>


            <form>


                <!-- ITEM NAME -->

                <div class="form_group">

                    <label for="name">
                        Item Name
                    </label>

                    <input type="text"
                           id="name"
                           name="name"
                           placeholder="Enter item name"
                           required />

                </div>


                <!-- PRICE -->

                <div class="form_group">

                    <label for="price">
                        Price
                    </label>

                    <input type="number"
                           id="price"
                           name="price"
                           placeholder="Enter price"
                           step="0.01"
                           min="0"
                           required />

                </div>


                <!-- INGREDIENTS -->

                <div class="form_group">

                    <label for="ingredients">
                        Ingredients
                    </label>

                    <textarea id="ingredients"
                              name="ingredients"
                              placeholder="Enter ingredients"
                              required></textarea>

                </div>


                <!-- CATEGORY -->

                <div class="form_group">

                    <label for="category">
                        Category
                    </label>

                    <select id="category"
                            name="category"
                            required>

                        <option value="">
                            Select Category
                        </option>

                        <option value="Bakery">
                            Bakery
                        </option>

                        <option value="Cold Grab N' Go">
                            Cold Grab N' Go
                        </option>

                    </select>

                </div>


                <!-- IMAGE -->

                <div class="form_group">

                    <label for="image">
                        Item Image
                    </label>

                    <input type="file"
                           id="image"
                           name="image"
                           accept="image/*" />

                    <div class="image_preview"
                         id="imagePreview">

                        <img id="previewImage"
                             alt="Image Preview" />

                    </div>

                </div>


                <!-- BUTTONS -->

                <div class="button_area">

                    <button type="submit"
                            class="btn btn_add">

                        Add Item

                    </button>


                    <a href="/"
                       class="btn btn_cancel">

                        Cancel

                    </a>

                </div>


            </form>

        </div>

    </main>


    <script>

        document
            .getElementById("image")
            .addEventListener("change", function (event) {

                const file = event.target.files[0];

                if (file) {

                    const reader = new FileReader();

                    reader.onload = function (e) {

                        document
                            .getElementById("previewImage")
                            .src = e.target.result;

                        document
                            .getElementById("imagePreview")
                            .style.display = "block";

                    };

                    reader.readAsDataURL(file);

                }

            });

    </script>

</body>

</html>