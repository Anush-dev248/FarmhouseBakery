@model IEnumerable<FarmhouseBakery.Models.MenuItem>

@{ ViewData["Title"] = "Menu Management"; }

<!DOCTYPE html> <html lang="en">

<head>

<meta charset="utf-8" />

<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<title>Menu Management - Farmhouse Bakery</title>

<style>

* { box-sizing: border-box; }

body { margin: 0; font-family: Arial, sans-serif; background: #f5f5f5; color: #333; }

.admin_header { background: #000; color: white; padding: 20px 40px; display: flex; justify-content: space-between; align-items: center; }

.admin_header h1 { margin: 0; font-size: 24px; }

.back_home { color: white; text-decoration: none; }

.back_home:hover { color: #ffbe33; }

.page_container { max-width: 1200px; margin: 40px auto; padding: 0 20px; }

.page_top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 25px; }

.page_top h2 { margin: 0; }

.add_btn { background: #ffbe33; color: white; padding: 12px 20px; border: none; border-radius: 6px; font-weight: 600; cursor: pointer; }

.add_btn:hover { background: #e5a500; }

.form_container { display: none; background: white; padding: 30px; border-radius: 10px; margin-bottom: 30px; box-shadow: 0 5px 20px rgba(0,0,0,0.10); }

.form_container.show { display: block; }

.form_container h3 { margin-top: 0; margin-bottom: 25px; }

.form_grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }

.form_group { display: flex; flex-direction: column; }

.form_group.full { grid-column: 1 / -1; }

.form_group label { margin-bottom: 7px; font-weight: 600; color: #444; }

.form_group input,
.form_group select,
.form_group textarea {
    width: 100%;
    padding: 12px;
    border: 1px solid #d5d5d5;
    border-radius: 6px;
    font-size: 15px;
    outline: none;
}

.form_group input:focus,
.form_group select:focus,
.form_group textarea:focus {
    border-color: #ffbe33;
}

.form_group textarea { min-height: 90px; resize: vertical; }

/* IMAGE UPLOAD */

.image_preview { width: 120px; height: 90px; object-fit: contain; border-radius: 6px; border: 1px solid #ddd; margin-top: 10px; display: none; background: #f8f8f8; }

.current_image { width: 120px; height: 90px; object-fit: contain; border-radius: 6px; border: 1px solid #ddd; margin-top: 10px; background: #f8f8f8; }

.image_note { font-size: 12px; color: #777; margin-top: 6px; }

.form_buttons { margin-top: 25px; display: flex; gap: 10px; }

.save_btn { background: #28a745; color: white; border: none; padding: 12px 25px; border-radius: 6px; cursor: pointer; font-weight: 600; }

.cancel_btn { background: #777; color: white; border: none; padding: 12px 25px; border-radius: 6px; cursor: pointer; font-weight: 600; }

.table_container { background: white; border-radius: 10px; overflow-x: auto; box-shadow: 0 5px 20px rgba(0,0,0,0.10); }

table { width: 100%; border-collapse: collapse; }

th { background: #222; color: white; padding: 15px; text-align: left; }

td { padding: 15px; border-bottom: 1px solid #eee; vertical-align: middle; }

tr:hover { background: #fafafa; }

.item_image { width: 70px; height: 60px; object-fit: contain; border-radius: 6px; }

.no_image { width: 70px; height: 60px; background: #eee; display: flex; align-items: center; justify-content: center; color: #888; font-size: 12px; border-radius: 6px; }

.actions { display: flex; gap: 8px; }

.edit_btn { background: #3498db; color: white; border: none; padding: 8px 14px; border-radius: 5px; cursor: pointer; }

.delete_btn { background: #dc3545; color: white; border: none; padding: 8px 14px; border-radius: 5px; cursor: pointer; }

.empty_message { text-align: center; padding: 40px; color: #777; }

@@media (max-width: 700px) {

.admin_header { padding: 18px 20px; }

.page_container { margin-top: 25px; }

.page_top { flex-direction: column; align-items: flex-start; gap: 15px; }

.form_grid { grid-template-columns: 1fr; }

.form_group.full { grid-column: auto; }

}

</style>

</head>

<body>

<!-- HEADER -->

<header class="admin_header">

<h1> Farmhouse Bakery </h1>

<div style="display: flex; align-items: center; gap: 20px;">

    <a href="@(User.IsInRole("Admin") ? "/Home/AdminIndex" : "/")" class="back_home">
        ← Back to Main
    </a>

    <form asp-controller="Account" asp-action="Logout" method="post" style="margin: 0;">
        @Html.AntiForgeryToken()
        <button type="submit"
                style="background: #ffbe33; color: #222; border: none; padding: 8px 18px; border-radius: 20px; font-weight: bold; cursor: pointer;">
            Logout
        </button>
    </form>

</div>

</header>

<!-- MAIN -->

<main class="page_container">

<!-- PAGE TOP -->

<div class="page_top">

<h2> Menu Management </h2>

<button type="button" class="add_btn" onclick="showAddForm()">

+ Add New Item

</button>

</div>

<!-- ADD / EDIT FORM -->

<div id="itemForm" class="form_container">

<h3 id="formTitle"> Add New Menu Item </h3>

<!--<form asp-controller="Menu" asp-action="Add" method="post" enctype="multipart/form-data" id="menuForm"> -->

<form asp-controller="Menu"
      asp-action="Save"
      method="post"
      enctype="multipart/form-data"
      id="menuForm">

@Html.AntiForgeryToken()

<div asp-validation-summary="All" style="color: #ff7777; margin-bottom: 12px;"></div>

<!-- ID -->

<input type="hidden" id="itemId" name="Id" value="0" />

<div class="form_grid">

<!-- NAME -->

<div class="form_group">

<label for="itemName"> Item Name </label>

<input type="text" id="itemName" name="Name" placeholder="Enter item name" required />

</div>

<!-- PRICE -->

<div class="form_group">

<label for="itemPrice"> Price </label>

<input type="number" id="itemPrice" name="Price" step="0.01" min="0.01" placeholder="20.00" required />

</div>

<!-- CATEGORY -->

<div class="form_group">

<label for="itemCategory"> Category </label>

<select id="itemCategory" name="Category" required>

<option value=""> Select Category </option>

<option value="Bakery"> Bakery </option>

<option value="Cold Grab N' Go"> Cold Grab N' Go </option>

<option value="Others">Others</option>

</select>

</div>

<!-- IMAGE -->

<div class="form_group">

    <label for="imageFile">
        Item Image
    </label>

    <input type="file"
           id="imageFile"
           name="imageFile"
           accept=".jpg,.jpeg,.png,.webp"
           onchange="previewImage(event)" />

    <img id="imagePreview"
         class="image_preview"
         alt="Image Preview" />

    <p class="image_note">
        Select an image from your computer.
    </p>

</div>

<!-- INGREDIENTS -->

<div class="form_group full">

<label for="itemIngredients"> Ingredients </label>

<textarea id="itemIngredients" name="Ingredients" placeholder="Enter ingredients" required></textarea>

</div>

</div>

<!-- BUTTONS -->

<div class="form_buttons">

<button type="submit" class="save_btn" id="saveButton">

Save Item

</button>

<button type="button" class="cancel_btn" onclick="cancelForm()">

Cancel

</button>

</div>

</form>

</div>


<!-- CATEGORY FILTER -->

<div style="margin-bottom: 20px; display: flex; align-items: center; gap: 12px; flex-wrap: wrap;">

    <label for="categoryFilter" style="font-weight: 600;">
        Filter by Category:
    </label>

    <select id="categoryFilter"
            onchange="filterMenuItems()"
            style="padding: 10px; border: 1px solid #d5d5d5; border-radius: 6px; min-width: 200px;">

        <option value="all">All Categories</option>
        <option value="Bakery">Bakery</option>
        <option value="Cold Grab N' Go">Cold Grab N' Go</option>
        <option value="Others">Others</option>

    </select>

</div>

<!-- TABLE -->

<div class="table_container">

@if (Model.Any()) {

<table>

<thead>

<tr>

<th>Image</th> <th>Name</th> <th>Price</th> <th>Category</th> <th>Ingredients</th> <th>Actions</th>

</tr>

</thead>

<tbody>

@foreach (var item in Model) {

<tr>

<!-- IMAGE -->

<td>

@if (!string.IsNullOrEmpty(item.ImageUrl)) {

<img src="@item.ImageUrl" alt="@item.Name" class="item_image" />

} else {

<div class="no_image"> No Image </div>

}

</td>

<!-- NAME -->

<td> <strong> @item.Name </strong> </td>

<!-- PRICE -->

<td> $@item.Price.ToString("0.00") </td>

<!-- CATEGORY -->

<td> @item.Category </td>

<!-- INGREDIENTS -->

<td> @item.Ingredients </td>

<!-- ACTIONS -->

<td>

<div class="actions">

<button type="button" class="edit_btn" onclick='editItem( @item.Id, @Html.Raw(System.Text.Json.JsonSerializer.Serialize(item.Name)), @item.Price, @Html.Raw(System.Text.Json.JsonSerializer.Serialize(item.Category)), @Html.Raw(System.Text.Json.JsonSerializer.Serialize(item.Ingredients)), @Html.Raw(System.Text.Json.JsonSerializer.Serialize(item.ImageUrl ?? "")) )'>

Edit

</button>

<form asp-controller="Menu" asp-action="Delete" method="post" onsubmit="return confirm('Are you sure you want to delete this item?');">

@Html.AntiForgeryToken()

<input type="hidden" name="id" value="@item.Id" />

<button type="submit" class="delete_btn">

Delete

</button>

</form>

</div>

</td>

</tr>

}

</tbody>

</table>

} else {

<div class="empty_message">

<h3> No menu items yet </h3>

<p> Click "Add New Item" to add your first menu item. </p>

</div>

}

</div>

</main>

<!-- JAVASCRIPT -->

<script>

function showAddForm() {

document.getElementById("itemForm") .classList.add("show");

document.getElementById("formTitle") .textContent = "Add New Menu Item";

document.getElementById("saveButton") .textContent = "Save Item";

document.getElementById("itemId") .value = "0";

document.getElementById("itemName") .value = "";

document.getElementById("itemPrice") .value = "";

document.getElementById("itemCategory") .value = "";

document.getElementById("itemIngredients") .value = "";

document.getElementById("imageFile") .value = "";

document.getElementById("imagePreview") .style.display = "none";

window.scrollTo({ top: 0, behavior: "smooth" });

}

function editItem(id, name, price, category, ingredients, image) {

    document.getElementById("itemForm").classList.add("show");

    document.getElementById("formTitle").textContent = "Edit Menu Item";

    document.getElementById("saveButton").textContent = "Update Item";

    document.getElementById("itemId").value = id;

    document.getElementById("itemName").value = name;

    document.getElementById("itemPrice").value = price;

    document.getElementById("itemCategory").value = category;

    document.getElementById("itemIngredients").value = ingredients;

    // Clear file input
    document.getElementById("imageFile").value = "";

    // Show existing image
    var preview = document.getElementById("imagePreview");

if (image && image.trim() !== "") {
    preview.onload = function () {
        preview.style.display = "block";
    };

    preview.onerror = function () {
        preview.style.display = "none";
        alert("The saved image could not be loaded. The image file may be missing from the website.");
    };

    preview.src = image;
    preview.style.display = "block";
} else {
    preview.removeAttribute("src");
    preview.style.display = "none";
}

    window.scrollTo({
        top: 0,
        behavior: "smooth"
    });
}

function previewImage(event) {

const file = event.target.files[0];

const preview = document.getElementById("imagePreview");

if (file) {

preview.src = URL.createObjectURL(file);

preview.style.display = "block";

} else {

preview.style.display = "none";

}

}

function cancelForm() {

document.getElementById("itemForm") .classList.remove("show");

document.getElementById("menuForm") .reset();

document.getElementById("itemId") .value = "0";

document.getElementById("imagePreview") .style.display = "none";

}

function filterMenuItems() {
    const selectedCategory =
        document.getElementById("categoryFilter").value;

    const rows = document.querySelectorAll(
        ".table_container tbody tr"
    );

    rows.forEach(function (row) {
        const categoryCell = row.cells[3];
        const category = categoryCell.textContent.trim();

        if (
            selectedCategory === "all" ||
            category === selectedCategory
        ) {
            row.style.display = "";
        } else {
            row.style.display = "none";
        }
    });
}
</script>

</body>

</html>