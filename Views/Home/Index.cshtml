    <header class="header_section" style="background-color: black; position: sticky; top: 0; z-index: 1000;">
        <div class="container">
            <nav class="navbar navbar-expand-lg custom_nav-container">

                <a class="navbar-brand" href="/">
                    <span>
                        <img src="~/images/LogoBLKbg.png"
                             width="50"
                             alt="Farmhouse Bakery" />
                        Farmhouse Bakery
                    </span>
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-toggle="collapse"
                        data-target="#navbarSupportedContent"
                        aria-controls="navbarSupportedContent"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span></span>
                </button>

                <div class="collapse navbar-collapse"
                     id="navbarSupportedContent">

                    <ul class="navbar-nav mx-auto">
                        <li class="nav-item active">
                            <a class="nav-link" href="/">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Home/Index#menu">Menu</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Home/Index#about">About</a>
                        </li>
                    </ul>

                    <div class="user_option">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <a href="/Menu/Manage" class="order_online" style="margin-right: 12px;">
                                Manage Menu
                            </a>
                        }

                        <a href="/Account/Login" class="user_link" title="Login">
