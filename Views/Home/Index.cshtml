    <!-- JAVASCRIPT -->

    <script src="~/js/jquery-3.4.1.min.js" asp-append-version="true"></script>

    <!--<script src="~/js/bakeryscript.js" asp-append-version="true"></script>

     <script src="https://unpkg.com/isotope-layout@3.0.4/dist/isotope.pkgd.min.js"></script> 

    <script src="~/js/custom.js" asp-append-version="true"></script> -->

    <!-- Bootstrap: opens the mobile navigation menu -->
    <script src="~/js/bakeryscript.js" asp-append-version="true"></script>

<script>
(function () {
    const year = document.getElementById("displayYear");
    if (year) year.textContent = new Date().getFullYear();

    const filters = document.querySelectorAll(".filters_menu li");
    const viewMoreLink = document.getElementById("viewMoreLink");
    const menuItems = document.getElementById("menuItems");
    const grid = document.querySelector(".grid");
    const cards = Array.from(document.querySelectorAll(".grid > .all"));

    const COLLAPSED_COUNT = 3;
    const EXPANDED_COUNT = 6;   // shown before the list starts scrolling

    let currentFilter = "*";
    let expanded = false;

    function matching(filter) {
        return cards.filter(function (card) {
            return filter === "*" ||
                card.classList.contains(filter.substring(1));
        });
    }

    // Collapsed: the first three items. Expanded: every item.
    function showCards(filter, showAll) {
        const matchingCards = matching(filter);

        cards.forEach(function (card) {
            card.style.setProperty("display", "none", "important");
        });

        (showAll ? matchingCards : matchingCards.slice(0, COLLAPSED_COUNT))
            .forEach(function (card) {
                card.style.setProperty("display", "block", "important");
            });
    }

    // Height of six cards at the current screen width
    // (two rows of three on desktop, more rows on smaller screens).
    function sixItemHeight() {
        const visible = cards.filter(function (card) {
            return card.offsetParent !== null;
        });

        if (!visible.length) return 0;

        const card = visible[0];
        const perRow = Math.max(1, Math.round(grid.clientWidth / card.offsetWidth));
        // The column's height already includes the card's top margin.
        const height = Math.ceil(EXPANDED_COUNT / perRow) * card.offsetHeight;

        // With fewer than three per row (tablets, phones) six items would be
        // taller than the screen, so cap the list at 75% of the screen height.
        if (perRow < 3) {
            return Math.min(height,
                Math.max(card.offsetHeight, Math.round(window.innerHeight * 0.75)));
        }

        return height;
    }

    // Reserve the height of the tallest collapsed filter result so the
    // page below the menu doesn't jump when switching filters.
    function reserveGridHeight() {
        if (!grid) return;

        grid.style.minHeight = "";

        let tallest = 0;
        ["*", ".bakery", ".burger", ".others"].forEach(function (filter) {
            showCards(filter, false);
            tallest = Math.max(tallest, grid.offsetHeight);
        });

        grid.style.minHeight = tallest + "px";
        render();
    }

    function render() {
        showCards(currentFilter, expanded);

        if (expanded) {
            // A fixed six-item window; anything beyond that scrolls.
            const height = sixItemHeight();
            menuItems.style.height = height + "px";
            menuItems.style.overflowY = "auto";
            menuItems.style.overflowX = "hidden";
        } else {
            menuItems.style.height = "";
            menuItems.style.overflowY = "";
            menuItems.style.overflowX = "";
            menuItems.scrollTop = 0;
        }

        if (viewMoreLink) {
            const hasMore = matching(currentFilter).length > COLLAPSED_COUNT;

            viewMoreLink.textContent = expanded ? "Show Less" : "View More";
            viewMoreLink.setAttribute("aria-expanded", expanded);
            // Hidden rather than removed, so the page doesn't shift.
            viewMoreLink.style.visibility =
                expanded || hasMore ? "visible" : "hidden";
        }
    }

    if (viewMoreLink) {
        viewMoreLink.addEventListener("click", function (event) {
            event.preventDefault();
            expanded = !expanded;
            render();
        });
    }

    filters.forEach(function (filterButton) {
        filterButton.addEventListener("click", function () {
            currentFilter = filterButton.getAttribute("data-filter");
            menuItems.scrollTop = 0;
            render();

            filters.forEach(function (item) {
                item.classList.remove("active");
            });

            filterButton.classList.add("active");
        });
    });

    render();

    // Measure again once images and fonts have loaded, and when the
    // window is resized (cards wrap differently at different widths).
    window.addEventListener("load", reserveGridHeight);

    let resizeTimer;
    window.addEventListener("resize", function () {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(reserveGridHeight, 150);
    });
})();
</script>

</body>

</html>