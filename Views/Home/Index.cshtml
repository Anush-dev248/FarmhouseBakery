@model IEnumerable<FarmhouseBakery.Models.MenuItem>

@{
    ViewData["Title"] = "Farmhouse Bakery";
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Farmhouse Bakery</title>

    <link rel="stylesheet" href="~/css/bakeryscript.css" />
    <!-- Font Awesome disabled -->
    <!-- <link rel="stylesheet" href="~/css/font-awesome.min.css" /> -->
    <link rel="stylesheet" href="~/css/style.css" />
    <link rel="stylesheet" href="~/css/responsive.css" />
</head>

<body>

    <!-- HERO -->
    <div class="hero_area">

        <div class="bg-box"
             style="background-color:black;
                    height:100%;
                    display:flex;
                    justify-content:flex-end;
                    align-items:center;">

            <img src="~/images/a1.png"
                 alt="Farmhouse Bakery"
                 style="height:100%;
                        width:58%;
                        object-fit:contain;">
        </div>

        <!-- HEADER -->
        <header class="header_section">
            <div class="container">

                <nav class="navbar navbar-expand-lg custom_nav-container">

                    <a class="navbar-brand" href="/">
                        <span>
                            <img src="~/images/LogoBLKbg.png"
                                 width="50"
                                 alt="Farmhouse Bakery">

                            Farmhouse Bakery
                        </span>
                    </a>

                    <button class="navbar-toggler"
                            type="button"
                            data-toggle="collapse"
                            data-target="#navbarSupportedContent"
                            aria-controls="navbarSupportedContent"
                            aria-expanded="false"
                            aria-label="Toggle navigation">

                        <span></span>

                    </button>

                    <div class="collapse navbar-collapse"
                         id="navbarSupportedContent">

                        <ul class="navbar-nav mx-auto">

                            <li class="nav-item active">
                                <a class="nav-link" href="/">
                                    Home
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" href="/Home/Index#menu">
                                    Menu
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" href="/Home/Index#about">
                                    About
                                </a>
                            </li>
                        </ul>

                        <!-- LOGIN ICON -->

                        <div class="user_option">

                            <a href="/Account/Login" class="user_link" title="Login">
                                <span class="login-icon">
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
       stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="12" cy="8" r="4"></circle>
    <path d="M4 21c0-4 3.5-7 8-7s8 3 8 7"></path>
  </svg>
</span>
                            </a>

                        </div>

                    </div>

                </nav>

            </div>
        </header>

        <!-- HERO SLIDER -->

        <section class="slider_section">

            <div id="customCarousel1"
                 class="carousel slide"
                 data-ride="carousel">

                <div class="carousel-inner">

                    <div class="carousel-item active">

                        <div class="container">

                            <div class="row">

                                <div class="col-md-7 col-lg-6">

                                    <div class="detail-box">

                                        <h1>
                                            Farmhouse Bakery
                                        </h1>

                                        <p>
                                            We believe great baking starts with
                                            quality ingredients and a whole lot
                                            of passion. Every treat is carefully
                                            prepared and freshly baked to bring
                                            a smile to your day.
                                        </p>

                                        <div class="btn-box">

                                            <a href="#menu"
                                               class="btn1">
                                                View
                                            </a>

                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </section>

    </div>


    <!-- MENU -->

    <section id="menu"
             class="food_section layout_padding-bottom">

        <div class="container">

            <div class="heading_container heading_center">

                <h2>
                    Our Menu
                </h2>

            </div>


            <ul class="filters_menu">

                <li class="active"
                    data-filter="*">
                    All
                </li>

                <li data-filter=".bakery">
                    Bakery
                </li>

                <li data-filter=".burger">
                    Cold Grab N' Go
                </li>

            </ul>


            <div class="filters-content">

                <div class="row grid">

        @foreach (var item in Model)
        {
            string categoryClass = "";

            if (item.Category == "Bakery")
            {
                categoryClass = "bakery";
            }
            else if (item.Category == "Cold Grab N' Go")
            {
                categoryClass = "burger";
            }

            <div class="col-sm-6 col-lg-4 all @categoryClass">

                <div class="box">

                    <div>

                        <div class="img-box">

                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl"
                                     alt="@item.Name">
                            }
                            else
                            {
                                <div style="height: 200px;
                                            display: flex;
                                            align-items: center;
                                            justify-content: center;
                                            background: #f5f5f5;
                                            color: #999;">
                                    No Image
                                </div>
                            }

                        </div>

                        <div class="detail-box">

                            <h5>
                                @item.Name
                            </h5>

                            <p>
                                @item.Ingredients
                            </p>

                            <div class="options">

                                <h6>
                                    $@item.Price.ToString("0.00")
                                </h6>

                            </div>

                        </div>

                    </div>

                </div>

            </div>
        }

    </div>

            </div>

        </div>
        </div>

        <div class="btn-box text-center" style="margin: 30px 0;">
            <a href="/Home/Menu#menu" class="btn1">
                View More
            </a>
        </div>

    </section>


    <!-- ABOUT -->

    <section id="about"
         class="about_section layout_padding">

        <div class="container">

            <div class="row">

                <div class="col-md-6">

                    <div class="img-box">

                        <img src="~/images/LogoBLKbg.png"
                             alt="Farmhouse Bakery">

                    </div>

                </div>

                <div class="col-md-6">

                    <div class="detail-box">

                        <div class="heading_container">

                            <h2>
                                We Are Farmhouse Bakery
                            </h2>

                        </div>

                        <p>
                            They say patience is a virtue, but in baking,
                            it’s an ingredient.

                            We believe that the best things in life aren’t
                            rushed—they are kneaded, proved, and fired
                            with intention.

                            Our bakery was born from a simple obsession:
                            taking the humble elements of flour, water,
                            and salt and transforming them through heat
                            and time into something extraordinary.
                        </p>

                        <a href="/Home/About">
                            Read More
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- LOCATION -->

    <section class="book_section layout_padding">

        <div class="container">

            <div class="heading_container">

                <h2>
                    Location
                </h2>

            </div>

            <div class="row">

                <div class="col-md-12">

                    <div class="map_container">

                        <iframe
                            src="https://www.google.com/maps?q=41+Ventura+Dr+Debert+NS+B0M+1G0&output=embed"
                            width="100%"
                            height="355"
                            style="border:0;"
                            allowfullscreen=""
                            loading="lazy">
                        </iframe>

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- FOOTER -->

    <footer class="footer_section">

        <div class="container">

            <div class="row">


                <div class="col-md-4 footer-col">

                    <div class="footer_contact">

                        <h4>
                            Contact Us
                        </h4>

                        <div class="contact_link_box">

                            <a href="tel:+19029561975">

                                <!-- <i class="fa fa-phone"
                                   aria-hidden="true"></i> -->
                                   <span>📞</span>

                                <span>
                                    Call +1 902 956 1975
                                </span>

                            </a>

                            <a href="mailto:farmhouse@bellaliant.net">

                                <span>✉️</span>

                                <span>
                                    farmhouse@bellaliant.net
                                </span>

                            </a>

                        </div>

                    </div>

                </div>


                <div class="col-md-4 footer-col">

                    <div class="footer_detail">

                        <a href="/"
                           class="footer-logo">

                            Farmhouse Bakery

                        </a>

                        <p>
                            41 Ventura Dr, Debert, NS B0M 1G0
                        </p>

                    </div>

                </div>


                <div class="col-md-4 footer-col">

                    <h4>
                        Opening Hours
                    </h4>

                    <p>
                        Monday - Friday
                    </p>

                    <p>
                        09.00 AM - 05.00 PM
                    </p>

                </div>

            </div>


            <div class="footer-info">

                <p>
                    &copy;
                    <span id="displayYear"></span>
                    Farmhouse Bakery
                </p>

            </div>

        </div>

    </footer>


    <!-- JAVASCRIPT -->

    <script src="~/js/jquery-3.4.1.min.js"></script>

    <script src="~/js/bakeryscript.js"></script>

    <script src="https://unpkg.com/isotope-layout@3.0.4/dist/isotope.pkgd.min.js"></script>

    <script src="~/js/custom.js"></script>


    <script>
        document.getElementById("displayYear").textContent =
            new Date().getFullYear();
    </script>

</body>

</html>