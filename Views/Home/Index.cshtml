</div>

</div>

</div>


    <!-- MENU -->

    <section id="menu"
             class="food_section layout_padding-bottom">

        <div class="container">

            <div class="heading_container heading_center">

                <h2>
                    Our Menu
                </h2>

            </div>


            <ul class="filters_menu">

                <li class="active"
                    data-filter="*">
                    All
                </li>

                <li data-filter=".bakery">
                    Bakery
                </li>

                <li data-filter=".burger">
                    Cold Grab N' Go
                </li>

                <li data-filter=".others">
                    Others
                </li>

            </ul>


            <div class="filters-content" id="menuItems">

                <div class="row grid">

        @foreach (var item in Model)
        {
            string categoryClass = "";

            string normalizedCategory = new string(
                (item.Category ?? "")
                    .Where(char.IsLetterOrDigit)
                    .ToArray()
            ).ToLowerInvariant();

            if (normalizedCategory == "bakery")
            {
                categoryClass = "bakery";
            }
            else if (normalizedCategory.Contains("grab") &&
                    normalizedCategory.Contains("go"))
            {
                categoryClass = "burger";
            }
            else if (normalizedCategory == "others" ||
                    normalizedCategory == "other")
            {
                categoryClass = "others";
            }
            <div class="col-sm-6 col-lg-4 all @categoryClass">

                <div class="box">

                    <div>

                        <div class="img-box">

                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl"
                                     alt="@item.Name">
                            }
                            else
                            {
                                <div style="height: 200px;
                                            display: flex;
                                            align-items: center;
                                            justify-content: center;
                                            background: #f5f5f5;
                                            color: #999;">
                                    No Image
                                </div>
                            }

                        </div>

                        <div class="detail-box">

                            <h5 title="@item.Name">
                                @item.Name
                            </h5>

                            <p title="@item.Ingredients">
                                @item.Ingredients
                            </p>

                            <div class="options">

                                <h6>
                                    $@item.Price.ToString("0.00")
                                </h6>

                            </div>

                        </div>

                    </div>

                </div>

            </div>
        }

    </div>

            </div>

        </div>
        </div>

        <div class="btn-box text-center" style="margin: 30px 0;">
    <a href="/Home/Menu?category=all#menu"
       id="viewMoreLink"
       class="btn1"
       role="button"
       aria-controls="menuItems"
       aria-expanded="false">
