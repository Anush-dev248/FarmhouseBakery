@model IEnumerable<FarmhouseBakery.Models.MenuItem>

@{
    ViewData["Title"] = "Farmhouse Bakery";
    Layout = null; // complete page; does not use _Layout
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Farmhouse Bakery</title>

    <link rel="stylesheet" href="~/css/bakeryscript.css" asp-append-version="true" />
    <!-- Font Awesome disabled -->
    <!-- <link rel="stylesheet" href="~/css/font-awesome.min.css" asp-append-version="true" /> -->
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/responsive.css" asp-append-version="true" />
    <style>
        /* Keep #menu / #about headings visible below the fixed header */
        html {
            scroll-padding-top: 90px;
        }

        .board_item {
            position: absolute;
            inset: 0;
            pointer-events: none;
            transition: filter 0.25s ease;
        }

        .board_item_shape {
            position: absolute;
            inset: 0;
            background: url("/images/heromarket.jpg") center / 100% 100% no-repeat;
            pointer-events: auto;
            transition: transform 0.25s ease;
        }

        .board_item:has(.board_item_shape:hover) {
            z-index: 5;
            filter: drop-shadow(0 12px 18px rgba(0, 0, 0, 0.75))
                    drop-shadow(0 0 12px rgba(255, 214, 140, 0.55));
        }

        .board_item_shape:hover {
            transform: scale(1.08);
        }

        @@media (prefers-reduced-motion: reduce) {
            .board_item,
            .board_item_shape {
                transition: none;
            }
        }
    </style>
</head>

<body>

