@model IEnumerable<FarmhouseBakery.Models.MenuItem>

@{
    ViewData["Title"] = "Admin Dashboard";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Admin Dashboard - Farmhouse Bakery</title>

    <link rel="stylesheet" href="~/css/bakeryscript.css" />
    <link rel="stylesheet" href="~/css/style.css" />
    <link rel="stylesheet" href="~/css/responsive.css" />
</head>

<body>

    <div class="hero_area">

        <div class="bg-box"
             style="background-color:black; height:100%;
                    display:flex; justify-content:flex-end;
                    align-items:center;">

            <img src="~/images/a1.png"
                 alt="Farmhouse Bakery"
                 style="height:100%; width:58%; object-fit:contain;" />
        </div>

        <header class="header_section">
            <div class="container">

                <nav class="navbar navbar-expand-lg custom_nav-container">

                    <a class="navbar-brand" href="/Home/AdminIndex">
                        <span>
                            <img src="~/images/LogoBLKbg.png"
                                 width="50"
                                 alt="Farmhouse Bakery" />
                            Farmhouse Bakery
                        </span>
                    </a>

                    <button class="navbar-toggler"
                            type="button"
                            data-toggle="collapse"
                            data-target="#navbarSupportedContent"
                            aria-controls="navbarSupportedContent"
                            aria-expanded="false"
                            aria-label="Toggle navigation">
                        <span></span>
                    </button>

                    <div class="collapse navbar-collapse"
                         id="navbarSupportedContent">

                        <ul class="navbar-nav mx-auto">

                            <!--<li class="nav-item active">
                                <a class="nav-link"
                                   href="/Home/AdminIndex">
                                    Home
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   href="/Home/Menu">
                                    Menu
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   href="/Home/Index#about">
                                    About
                                </a>
                            </li> -->

                            @if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link"
                                       href="/Account/Register">
                                        Registration
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link"
                                       href="/Menu/Manage">
                                        Menu Items
                                    </a>
                                </li>
                            }

                        </ul>

                        <div class="user_option">

                            <form asp-controller="Account"
                                  asp-action="Logout"
                                  method="post"
                                  style="display:inline;">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="order_online"
                                        style="border:none; cursor:pointer;">
                                    Logout
                                </button>

                            </form>

                        </div>

                    </div>
                </nav>
            </div>
        </header>

        <section class="slider_section">
            <div class="container">
                <div class="detail-box">

                    <h1>Admin Dashboard</h1>

                    <p>
                        Welcome to Farmhouse Bakery!
                        Manage your bakery registration
                        and menu items here.
                    </p>

                    <div style="margin-top:25px;">
                        <a href="/Account/Register" class="order_online">
                            Registration
                        </a>

                        <a href="/Menu/Manage"
                           class="order_online"
                           style="margin-left:10px;">
                            Manage Menu
                        </a>
                    </div>

                </div>
            </div>
        </section>

    </div>

    <script src="~/js/jquery-3.4.1.min.js"></script>
    <script src="~/js/bakeryscript.js"></script>
    <script src="~/js/custom.js"></script>

</body>
</html>