@model IEnumerable<FarmhouseBakery.Models.MenuItem>

@{
    ViewData["Title"] = "Our Menu";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Our Menu - Farmhouse Bakery</title>

    <link rel="stylesheet" href="~/css/bakeryscript.css" />
    <link rel="stylesheet" href="~/css/style.css" />
    <link rel="stylesheet" href="~/css/responsive.css" />
    <!-- Comic font + pop art style for the "Special" menu tab -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bangers&display=swap" />
    <link rel="stylesheet" href="~/css/special-tab.css" asp-append-version="true" />
</head>

<body>

<!-- HEADER -->
<header class="header_section" style="background-color: black;">
            <div class="container">

                <nav class="navbar navbar-expand-lg custom_nav-container">

                    <a class="navbar-brand" href="/">
                        <span>
                            <img src="~/images/LogoBLKbg.png"
                                 width="50"
                                 alt="Farmhouse Bakery">

                            Farmhouse Bakery
                        </span>
                    </a>

                    <button class="navbar-toggler"
                            type="button"
                            data-toggle="collapse"
                            data-target="#navbarSupportedContent"
                            aria-controls="navbarSupportedContent"
                            aria-expanded="false"
                            aria-label="Toggle navigation">

                        <span></span>

                    </button>

                    <div class="collapse navbar-collapse"
                         id="navbarSupportedContent">

                        <ul class="navbar-nav mx-auto">

                            <li class="nav-item">
                                <a class="nav-link" href="/">
                                    Home
                                </a>
                            </li>

                            <li class="nav-item active">
                                <a class="nav-link" href="/Home/Menu">
                                Menu
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" href="/Home/Index#about">
                                    About
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" href="/Careers">
                                    Careers
                                </a>
                            </li>
                        </ul>

                        <!-- LOGIN ICON -->

                        <div class="user_option">

                            <a href="/Account/Login" class="user_link" title="Login">
                                <span class="login-icon">
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
       stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="12" cy="8" r="4"></circle>
    <path d="M4 21c0-4 3.5-7 8-7s8 3 8 7"></path>
  </svg>
</span>
                            </a>

                        </div>

                    </div>

                </nav>

            </div>
        </header>

    <section id="menu" class="food_section layout_padding">
        <div class="container">

            <div class="heading_container heading_center">
                <h2>All Menu Items</h2>
            </div>

            <ul class="filters_menu">
                <li class="special_tab" data-filter=".special">Special</li>
                <li class="active" data-filter="*">All</li>
                <li data-filter=".bakery">Bakery</li>
                <li data-filter=".burger">Cold Grab N' Go</li>
                <li data-filter=".others">Others</li>
                
            </ul>

            <div class="filters-content">
                <div class="row grid">

                    @foreach (var item in Model)
                    {
                        string categoryClass = "";

                        if (item.Category == "Special")
                        {
                            categoryClass = "special";
                        }
                        else if (item.Category == "Bakery")
                        {
                            categoryClass = "bakery";
                        }
                        else if (item.Category == "Cold Grab N' Go")
                        {
                            categoryClass = "burger";
                        }
                        else if (item.Category == "Others")
                        {
                            categoryClass = "others";
                        }

                        <div class="col-sm-6 col-lg-4 all @categoryClass">
                            <div class="box">

                                <div class="img-box">
                                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl"
                                             alt="@item.Name" />
                                    }
                                    else
                                    {
                                        <div style="height:200px; display:flex;
                                                    align-items:center;
                                                    justify-content:center;
                                                    background:#f5f5f5;
                                                    color:#999;">
                                            No Image
                                        </div>
                                    }
                                </div>

                                <div class="detail-box">
                                    <h5>@item.Name</h5>
                                    <p>@item.Ingredients</p>

                                    <div class="options">
                                        <h6>$@item.Price.ToString("0.00")</h6>
                                    </div>
                                </div>

                            </div>
                        </div>
                    }

                </div>
            </div>

            @if (!Model.Any())
            {
                <div class="heading_container heading_center">
                    <p>No menu items are available yet. Please check back soon!</p>
                </div>
            }

            <div class="btn-box text-center" style="margin-top:30px;">
                <a href="/" class="btn1">Back to Home</a>
            </div>

        </div>
    </section>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/bakeryscript.js"></script>
    <script src="~/lib/isotope/isotope.pkgd.min.js"></script>
    <script src="~/js/custom.js"></script>

    <script>

$(function () {
    const params = new URLSearchParams(window.location.search);
    const category = params.get("category") || "all";

    const filters = {
        all: "*",
        special: ".special",
        bakery: ".bakery",
        burger: ".burger",
        others: ".others"
    };

    const selectedFilter = filters[category] || "*";

    var $grid = $(".grid").isotope({
        itemSelector: ".all",
        layoutMode: "fitRows",
        filter: selectedFilter
    });

    $(".filters_menu li").each(function () {
        $(this).toggleClass(
            "active",
            $(this).attr("data-filter") === selectedFilter
        );
    });

    $(".filters_menu li").on("click", function () {
        $(".filters_menu li").removeClass("active");
        $(this).addClass("active");

        $grid.isotope({
            filter: $(this).attr("data-filter")
        });
    });
});
    </script>

</body>
</html>