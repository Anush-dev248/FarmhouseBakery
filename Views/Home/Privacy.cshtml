@{
    ViewData["Title"] = "Privacy Policy";
}

<div style="min-height:100vh; background:#f5f5f5; font-family:Arial,sans-serif; padding:40px 16px;">
    <div style="max-width:800px; margin:0 auto; background:white; padding:40px; border-radius:12px; box-shadow:0 8px 30px rgba(0,0,0,0.1); color:#444; line-height:1.7;">

        <h1 style="color:#222; margin-top:0;">Privacy Policy</h1>

        <p style="color:#888;">Farmhouse Bakery · 41 Ventura Dr, Debert, NS B0M 1G0</p>

        <h4 style="color:#222; margin-top:28px;">Visitors</h4>
        <p>
            You can view our menu and website without creating an account.
            We do not ask visitors for any personal information, and we do not
            use advertising or tracking cookies.
        </p>

        <h4 style="color:#222; margin-top:28px;">Staff accounts</h4>
        <p>
            Staff who log in to manage the menu have an account with their
            email address and a password. Passwords are never stored as plain
            text; only a secure one-way hash is kept. Email addresses are used
            only to log in and to send password reset emails.
        </p>

        <h4 style="color:#222; margin-top:28px;">Job applicants</h4>
        <p>
            When you apply for a job on our Careers page, we collect your name,
            email address, phone number (if given), message and resume. This
            information is only used to review your application, is stored
            privately, and can only be seen by our managers. To limit spam, each
            email address can apply up to 2 times in 30 days. To have your
            application removed, contact us using the details below.
        </p>

        <h4 style="color:#222; margin-top:28px;">Cookies</h4>
        <p>
            We only use cookies that the website needs to work: a login cookie
            for staff who are signed in, and a security cookie that protects
            forms from misuse.
        </p>

        <h4 style="color:#222; margin-top:28px;">Google Maps</h4>
        <p>
            Our home page shows our location using an embedded Google Map.
            When it loads, Google may collect information according to the
            <a href="https://policies.google.com/privacy" target="_blank" rel="noopener" style="color:#d89500;">Google Privacy Policy</a>.
        </p>

        <h4 style="color:#222; margin-top:28px;">YouTube video</h4>
        <p>
            Our home page includes a YouTube video in YouTube's privacy-enhanced
            mode, which does not set tracking cookies until you press play. Once
            you play it, YouTube (Google) may collect information according to the
            <a href="https://policies.google.com/privacy" target="_blank" rel="noopener" style="color:#d89500;">Google Privacy Policy</a>.
        </p>

        <h4 style="color:#222; margin-top:28px;">Contact us</h4>
        <p>
            Questions about your information? Email
            <a href="mailto:farmhouse@bellaliant.net" style="color:#d89500;">farmhouse@bellaliant.net</a>
            or call <a href="tel:+19029561975" style="color:#d89500;">+1 902 956 1975</a>.
        </p>

        <a href="/"
           style="display:inline-block; margin-top:20px; padding:12px 24px; background:#ffbe33; color:#222; text-decoration:none; border-radius:25px; font-weight:bold;">
            ← Back to Home
        </a>

    </div>
</div>
